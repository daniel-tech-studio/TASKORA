# TASKORA backend — copier vers .env puis remplacer les secrets (voir README).
NODE_ENV=development
PORT=3000
# Chemin relatif au dossier prisma/ (convention Prisma SQLite).
DATABASE_URL=file:./data/dev.db
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
CSRF_SECRET=
JWT_ISSUER=taskora
JWT_AUDIENCE=taskora-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Origines autorisées (séparées par des virgules) pour CORS et contrôle Origin.
FRONTEND_ORIGIN=http://localhost:5173
# true en HTTPS : cookies Secure + préfixe __Host-. Ne jamais mettre false en production.
COOKIE_SECURE=false
LOG_LEVEL=info
# Swagger (/api/docs) : activé par défaut hors production.
SWAGGER_ENABLED=true
# Seuils de limitation (conventions d'exploitation, backend.md E4).
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_GLOBAL_TTL_SECONDS=60
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_SECONDS=900
THROTTLE_REGISTER_LIMIT=3
THROTTLE_REGISTER_TTL_SECONDS=3600
THROTTLE_REFRESH_LIMIT=30
THROTTLE_REFRESH_TTL_SECONDS=600
